    "precheck": [
      {
        "description": "ensure FK \"Ticket_authorId_fkey\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Ticket_authorId_fkey",
          "public",
          "\"public\".\"Ticket\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add FK \"Ticket_authorId_fkey\"",
        "sql": "ALTER TABLE \"public\".\"Ticket\"\nADD CONSTRAINT \"Ticket_authorId_fkey\"\nFOREIGN KEY (\"authorId\")\nREFERENCES \"public\".\"User\" (\"id\")\nON DELETE RESTRICT\nON UPDATE CASCADE"
      }
    ],
    "postcheck": [
      {
        "description": "verify FK \"Ticket_authorId_fkey\" exists",
