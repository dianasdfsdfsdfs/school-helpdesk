
generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  password String
  name String
  token String?
  role Role @default(USER)

  tickets Ticket[]
}

enum Role {
  USER
  ADMIN
}

model Ticket {
  id Int @id @default(autoincrement())
  title String
  description String
  room String
  status Status @default(NEW)
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id])
  authorId Int

  category Category @relation(fields: [categoryId], references: [id])
  categoryId Int
}

enum Status {
  NEW
  IN_PROGRESS
  DONE
}

model Category {
  id Int @id @default(autoincrement())
  name String @unique

  tickets Ticket[]
}
