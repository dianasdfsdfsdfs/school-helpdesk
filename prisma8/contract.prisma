// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model Category {
    id      Int      @id(map: "Category_pkey") @default(autoincrement())
    name    String
    tickets Ticket[]

    @@index([name], map: "Category_name_key", unique: true)
  }

  model User {
    id       Int           @id(map: "User_pkey") @default(autoincrement())
    email    String
    password String
    name     String
    token    String?
    role     pg.enum(Role) @default("USER")
    tickets  Ticket[]

    @@index([email], map: "User_email_key", unique: true)
  }

  model Ticket {
    id          Int                @id(map: "Ticket_pkey") @default(autoincrement())
    title       String
    description String
    room        String
    status      pg.enum(Status)    @default("NEW")
    createdAt   TimestampString(3) @default(now())
    authorId    Int
    categoryId  Int
    author      User               @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Ticket_authorId_fkey", index: false)
    category    Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Ticket_categoryId_fkey", index: false)
  }

  native_enum Role {
    USER = "USER"
    ADMIN = "ADMIN"
  }

  native_enum Status {
    NEW = "NEW"
    IN_PROGRESS = "IN_PROGRESS"
    DONE = "DONE"
  }
}
